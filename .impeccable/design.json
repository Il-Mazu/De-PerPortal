      "css": ".ds-nav{display:flex;align-items:center;justify-content:space-between;gap:16px;height:64px;padding:0 20px;background:linear-gradient(#070d33e6,#070d3300)}.ds-brand{color:#eef1ff;text-decoration:none;font:400 1.2rem/1 'Lilita One',Nunito,sans-serif}.ds-link{color:#b4bde6;text-decoration:none;font:700 .95rem Nunito,sans-serif;padding:8px 12px;border-radius:99px;transition:color .15s,background-color .15s}.ds-link:hover{color:#fff;background:#ffffff12}.ds-link:focus-visible{outline:3px solid #f6c64f;outline-offset:3px}"
    }
