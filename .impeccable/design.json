      "css": ".ds-keys{color:#eef1ff;font:500 15px Nunito,sans-serif}.ds-kbd{display:inline-block;min-width:1.7em;padding:.1em .45em;border-radius:6px;font:800 .78em/1.4 Nunito,sans-serif;text-align:center;color:#3b2604;background:linear-gradient(180deg,#fff3c4,#e9b84a);box-shadow:0 2px 0 #7a4c0e,0 3px 6px #0006}"
