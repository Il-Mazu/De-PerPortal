      "css": ".ds-input{border:1.5px solid transparent;border-radius:10px;padding:8px 12px;font:700 14px/1.45 Nunito,sans-serif;color:#eef1ff;background:linear-gradient(#0e1440,#18215a) padding-box,linear-gradient(165deg,#fff1b8,#f6c64f 30%,#9a6415 55%,#e7b347 80%,#fff1b8) border-box;box-shadow:inset 0 2px 6px #0008}.ds-input::placeholder{color:#aab4e2}.ds-input:focus-visible{outline:3px solid #fff1b8;outline-offset:3px}"
