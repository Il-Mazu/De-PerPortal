      "css": ".ds-tabs{display:flex;gap:8px}.ds-tab{border:0;cursor:pointer;padding:10px 18px;border-radius:99px;font:400 1.02rem/1 'Lilita One',Nunito,sans-serif;color:#b4bde6;background:#0a0f3399;box-shadow:inset 0 0 0 1.5px #aab4e233;transition:color .2s,box-shadow .2s}.ds-tab:hover{color:#fff;box-shadow:inset 0 0 0 1.5px #f6c64f}.ds-tab[aria-selected=true]{color:#3b1d02;background:linear-gradient(180deg,#ffe48a,#f6c64f 55%,#d9962a);box-shadow:0 3px 0 #8a5410}.ds-tab:focus-visible{outline:3px solid #f6c64f;outline-offset:3px}"
