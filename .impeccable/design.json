      "css": ".ds-btn-app{cursor:pointer;border:1.5px solid transparent;border-radius:10px;padding:8px 14px;font:700 14px/1.45 Nunito,sans-serif;color:#eef1ff;background:linear-gradient(180deg,#34479e,#1d2866) padding-box,linear-gradient(165deg,#fff1b8,#f6c64f 30%,#9a6415 55%,#e7b347 80%,#fff1b8) border-box;box-shadow:0 3px 0 #05081c,inset 0 1px 0 #ffffff30;transition:transform .15s,filter .15s,box-shadow .15s}.ds-btn-app:hover{filter:brightness(1.18);transform:translateY(-1px)}.ds-btn-app:active{transform:translateY(2px);box-shadow:0 1px 0 #05081c}.ds-btn-app:focus-visible{outline:3px solid #fff1b8;outline-offset:3px}"
