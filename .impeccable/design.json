      "css": ".ds-btn-gilt{display:inline-flex;align-items:center;gap:.55em;padding:.78em 1.35em;border:0;border-radius:99px;cursor:pointer;font:400 1.08rem/1 'Lilita One',Nunito,sans-serif;letter-spacing:.01em;color:#3b1d02;background:linear-gradient(180deg,#ffe48a,#f6c64f 45%,#e09a26);box-shadow:inset 0 1px 0 #fff8,inset 0 0 0 1.5px #fff1b8aa,0 4px 0 #8a5410,0 10px 22px #0008;transition:transform .18s cubic-bezier(.16,1,.3,1),box-shadow .18s cubic-bezier(.16,1,.3,1)}.ds-btn-gilt:hover{transform:translateY(-2px);box-shadow:inset 0 1px 0 #fff8,inset 0 0 0 1.5px #fff1b8aa,0 6px 0 #8a5410,0 16px 28px #000a}.ds-btn-gilt:active{transform:translateY(3px);box-shadow:inset 0 1px 0 #fff8,0 1px 0 #8a5410,0 4px 10px #0008}.ds-btn-gilt:focus-visible{outline:3px solid #f6c64f;outline-offset:3px}"
    },
